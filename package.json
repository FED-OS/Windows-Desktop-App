{
  "name": "FED-OS-desktop",
  "version": "1.0.0",
  "author": "Viral",
  "description": "Desktop client for fed-os.github.io/Fed-Poster/",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.yourdomain.app",
    "productName": "FED-OS",
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/tdhdthd.ico"
    },
    "nsis": {
      "installerIcon": "src/tdhdthd.ico",
      "uninstallerIcon": "src/tdhdthd.ico"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
